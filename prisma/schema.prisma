// Olyon - Multi-tenant SaaS
// Schema compartilhado entre olyon-admin e olyon-app

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Role global do usuário (acesso ao olyon-admin). SUPER_ADMIN não possui membership.
enum GlobalRole {
  SUPER_ADMIN
}

// Role dentro de uma loja (Membership). Usado no olyon-app.
enum MembershipRole {
  OWNER  // dono da loja
  ADMIN  // gerente
  STAFF  // funcionário
}

enum MembershipType {
  PROFISSIONAL
  FINANCEIRO
  ATENDENTE
}

model User {
  id          String        @id @default(cuid())
  name        String
  email       String        @unique
  password    String
  globalRole  GlobalRole?   // SUPER_ADMIN => sem membership, acesso apenas olyon-admin
  memberships Membership[]
  profile     UserProfile?
  contacts    UserContact[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Store {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  active      Boolean       @default(true) // toda loja nasce ativa
  memberships Membership[]
  services    Service[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  

  events Event[]
}

model Membership {
  id        String         @id @default(cuid())
  role      MembershipRole
  userId    String
  storeId   String

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  types     MembershipTypeLink[]
  services  MembershipService[]

  @@unique([userId, storeId])
}

model MembershipTypeLink {
  membershipId String
  type         MembershipType

  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([membershipId, type])
  @@index([type])
}

model MembershipService {
  membershipId String
  serviceId    String

  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  service      Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([membershipId, serviceId])
  @@index([serviceId])
}

model Service {
  id          String   @id @default(cuid())
  storeId     String
  name        String
  description String?
  durationMin Int
  active      Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  membershipServices MembershipService[]
  eventServices      EventService[]   // ✅ ADD

  @@index([storeId])
  @@unique([storeId, name])
}

model UserProfile {
  userId        String    @id
  cpf           String?   @unique // opcional, mas único se existir
  phone         String?
  secondaryPhone String?
  gender        String?   // storage do JSON { _id, value } ou simples string
  birthDate     DateTime?
  zipcode       String?
  state         String?
  city          String?
  neighborhood  String?
  address       String?
  number        String?
  complement    String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserContact {
  id            String    @id @default(cuid())
  userId        String
  name          String
  phone         String
  relationship  String

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Event {
  id          String   @id @default(cuid())
  storeId     String
  name        String
  description String?
  durationMin Int?
  active      Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  services    EventService[]          // ✅ ADD

  @@index([storeId])
  @@unique([storeId, name])
}

model EventService {
  eventId   String
  serviceId String

  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([eventId, serviceId])
  @@index([serviceId])
}
