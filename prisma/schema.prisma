// Olyon - Multi-tenant SaaS
// Schema compartilhado entre olyon-admin e olyon-app

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Role global do usuário (acesso ao olyon-admin). SUPER_ADMIN não possui membership.
enum GlobalRole {
  SUPER_ADMIN
}

// Role dentro de uma loja (Membership). Usado no olyon-app.
enum MembershipRole {
  OWNER // dono da loja
  ADMIN // gerente
  STAFF // funcionário
}

enum MembershipType {
  PROFISSIONAL
  FINANCEIRO
  ATENDENTE
}

model User {
  id          String        @id @default(cuid())
  name        String
  email       String        @unique
  password    String
  globalRole  GlobalRole? // SUPER_ADMIN => sem membership, acesso apenas olyon-admin
  memberships Membership[]
  profile     UserProfile?
  contacts    UserContact[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Store {
  id                   String              @id @default(cuid())
  name                 String
  slug                 String              @unique
  active               Boolean             @default(true)
  phone                String?
  whatsappPhone        String?
  address              String?
  complement           String?
  neighborhood         String?
  city                 String?
  state                String?
  zipcode              String?
  serviceObservations  String?
  businessHoursSummary String?
  memberships          Membership[]
  services             Service[]
  whatsappConnection   WhatsAppConnection?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  events Event[]

  // ✅ ADD (opostos das relações novas)
  conversations        Conversation[]
  conversationMessages ConversationMessage[]
  appointmentDrafts    AppointmentDraft[]
  appointments         Appointment[]

  blockedSchedules BlockedSchedule[]

  weekScheduleDays WeekScheduleDay[]
}

model Membership {
  id      String         @id @default(cuid())
  role    MembershipRole
  userId  String
  storeId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  types    MembershipTypeLink[]
  services MembershipService[]

  // ✅ ADD
  appointments      Appointment[]
  appointmentDrafts AppointmentDraft[]

  @@unique([userId, storeId])
}

model MembershipTypeLink {
  membershipId String
  type         MembershipType

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([membershipId, type])
  @@index([type])
}

model MembershipService {
  membershipId String
  serviceId    String

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  service    Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([membershipId, serviceId])
  @@index([serviceId])
}

model Service {
  id          String  @id @default(cuid())
  storeId     String
  name        String
  description String?
  durationMin Int
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  membershipServices MembershipService[]
  eventServices      EventService[]

  // ✅ ADD
  appointments      Appointment[]
  appointmentDrafts AppointmentDraft[]

  @@unique([storeId, name])
  @@index([storeId])
}

model UserProfile {
  userId         String    @id
  cpf            String?   @unique // opcional, mas único se existir
  phone          String?
  secondaryPhone String?
  gender         String? // storage do JSON { _id, value } ou simples string
  birthDate      DateTime?
  zipcode        String?
  state          String?
  city           String?
  neighborhood   String?
  address        String?
  number         String?
  complement     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserContact {
  id           String @id @default(cuid())
  userId       String
  name         String
  phone        String
  relationship String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Event {
  id          String  @id @default(cuid())
  storeId     String
  name        String
  description String?
  durationMin Int?
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  services EventService[] // ✅ ADD

  @@unique([storeId, name])
  @@index([storeId])
}

model EventService {
  eventId   String
  serviceId String

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([eventId, serviceId])
  @@index([serviceId])
}

enum Channel {
  WHATSAPP
  WEB
  ADMIN
}

enum WhatsAppProvider {
  META_WHATSAPP
}

enum WhatsAppConnectionStatus {
  PENDING
  VERIFIED
  CONNECTED
  DISCONNECTED
  ERROR
}

enum ConversationState {
  IDLE
  COLLECTING_CUSTOMER
  CHOOSING_APPOINTMENT
  CHOOSING_APPOINTMENT_ACTION
  CHOOSING_SERVICE
  CHOOSING_STAFF
  CHOOSING_TIME
  CONFIRMING
  CONFIRMING_APPOINTMENT_CANCELLATION
}

enum MessageDirection {
  IN
  OUT
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CANCELED
  DONE
  NO_SHOW
}

enum DraftStatus {
  DRAFT
  CONFIRMED
  ABANDONED
}

enum Weekday {
  SUN
  MON
  TUE
  WED
  THU
  FRI
  SAT
}

model Conversation {
  id            String            @id @default(cuid())
  storeId       String
  channel       Channel
  contact       String // telefone E.164 p/ WhatsApp, ou outro identificador
  state         ConversationState @default(IDLE)
  context       Json? // estado auxiliar (tentativas, lastMenu, timezone, etc.)
  lastMessageAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store    Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  messages ConversationMessage[]
  drafts   AppointmentDraft[]

  @@unique([storeId, channel, contact])
  @@index([storeId, lastMessageAt])
}

model WhatsAppConnection {
  id                 String                   @id @default(cuid())
  storeId            String                   @unique
  provider           WhatsAppProvider         @default(META_WHATSAPP)
  phoneNumberId      String                   @unique
  businessAccountId  String
  displayPhoneNumber String
  verifyToken        String                   @unique
  accessToken        String
  status             WhatsAppConnectionStatus @default(PENDING)
  isActive           Boolean                  @default(true)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([businessAccountId])
  @@index([provider, isActive])
}

model ConversationMessage {
  id                String           @id @default(cuid())
  storeId           String
  conversationId    String
  direction         MessageDirection
  providerMessageId String? // idempotência (WhatsApp message id)
  text              String?
  payload           Json? // raw do provider (log/auditoria)
  createdAt         DateTime         @default(now())

  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([storeId, providerMessageId])
  @@index([conversationId, createdAt])
}

model AppointmentDraft {
  id             String      @id @default(cuid())
  storeId        String
  conversationId String
  status         DraftStatus @default(DRAFT)

  serviceId         String?
  staffMembershipId String?
  customerName      String?
  customerPhone     String?
  customerEmail     String?

  startAt DateTime?
  endAt   DateTime?
  notes   String?

  // opcional: espelhar origem pra rastreio
  channel Channel

  // ponte pro appointment final (quando confirmar)
  appointmentId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  service      Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  membership   Membership?  @relation(fields: [staffMembershipId], references: [id], onDelete: SetNull)
  appointment  Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([storeId, status])
  @@index([conversationId, status])
}

model Appointment {
  id      String            @id @default(cuid())
  storeId String
  status  AppointmentStatus @default(SCHEDULED)

  serviceId         String?
  staffMembershipId String?

  customerName  String
  customerPhone String?
  customerEmail String?

  startAt DateTime
  endAt   DateTime
  notes   String?

  source      Channel // ADMIN/WEB/WHATSAPP
  externalRef String? // id do provider ou correlacao
  metadata    Json? // extras do canal

  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  draft      AppointmentDraft?
  store      Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  service    Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  membership Membership?       @relation(fields: [staffMembershipId], references: [id], onDelete: SetNull)

  @@index([storeId, startAt])
  @@index([storeId, status])
}

model WeekScheduleDay {
  id      String  @id @default(cuid())
  storeId String
  weekday Weekday
  enabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store     Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  intervals WeekScheduleInterval[]

  @@unique([storeId, weekday])
  @@index([storeId])
}

model WeekScheduleInterval {
  id        String @id @default(cuid())
  dayId     String
  startTime String // "HH:MM"
  endTime   String // "HH:MM"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  day WeekScheduleDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([dayId])
}

model BlockedSchedule {
  id        String   @id @default(cuid())
  storeId   String
  date      DateTime // armazenar como date (00:00 UTC/local), no frontend usa YYYY-MM-DD
  allDay    Boolean  @default(false)
  startTime String? // "HH:MM"
  endTime   String? // "HH:MM"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, date])
}
