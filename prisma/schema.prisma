generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String         @id @default(cuid())
  email                  String         @unique
  name                   String
  createdAt              DateTime       @default(now())
  password               String
  globalRole             GlobalRole?
  updatedAt              DateTime       @updatedAt
  memberships            Membership[]
  contacts               UserContact[]
  profile                UserProfile?
  financeEntriesCreated  FinanceEntry[] @relation("FinanceEntriesCreatedByUser")
}

model Store {
  id                   String                @id @default(cuid())
  name                 String
  createdAt            DateTime              @default(now())
  active               Boolean               @default(true)
  updatedAt            DateTime              @updatedAt
  slug                 String                @unique
  phone                String?
  whatsappPhone        String?
  address              String?
  clients              Client[]
  complement           String?
  neighborhood         String?
  city                 String?
  state                String?
  zipcode              String?
  serviceObservations  String?
  businessHoursSummary String?
  appointments         Appointment[]
  appointmentDrafts    AppointmentDraft[]
  blockedSchedules     BlockedSchedule[]
  conversations        Conversation[]
  conversationMessages ConversationMessage[]
  events               Event[]
  financeEntries       FinanceEntry[]
  memberships          Membership[]
  services             Service[]
  weekScheduleDays     WeekScheduleDay[]
  WhatsAppConnection   WhatsAppConnection?
}

model Membership {
  id                        String                        @id @default(cuid())
  role                      MembershipRole
  userId                    String
  storeId                   String
  appointments              Appointment[]
  appointmentDrafts         AppointmentDraft[]
  blockedSchedules          BlockedSchedule[]
  professionalWeekSchedules MembershipWeekScheduleDay[]
  store                     Store                         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user                      User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  services                  MembershipService[]
  types                     MembershipTypeLink[]

  @@unique([userId, storeId])
}

model Client {
  id             String   @id @default(cuid())
  storeId        String
  name           String
  email          String?
  cpf            String?
  phone          String?
  secondaryPhone String?
  gender         String?
  birthDate      DateTime?
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([storeId, name])
  @@index([storeId, email])
  @@index([storeId, cpf])
  @@index([storeId, isActive])
}

model MembershipTypeLink {
  membershipId String
  type         MembershipType
  membership   Membership     @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([membershipId, type])
  @@index([type])
}

model MembershipService {
  membershipId String
  serviceId    String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  service      Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([membershipId, serviceId])
  @@index([serviceId])
}

enum FinanceEntryType {
  INCOME
  EXPENSE
}

enum FinanceEntryStatus {
  PENDING
  PAID
  OVERDUE
}

model FinanceEntry {
  id              String             @id @default(cuid())
  storeId         String
  createdById     String?
  type            FinanceEntryType
  status          FinanceEntryStatus @default(PENDING)
  amount          Decimal            @db.Decimal(12, 2)
  category        String
  description     String?
  transactionDate DateTime
  dueDate         DateTime?
  paidAt          DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  store     Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdBy User? @relation("FinanceEntriesCreatedByUser", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([storeId, transactionDate])
  @@index([storeId, dueDate])
  @@index([storeId, status])
  @@index([storeId, type])
  @@index([createdById])
}

model Service {
  id                 String              @id @default(cuid())
  storeId            String
  name               String
  description        String?
  durationMin        Int
  price              Decimal?            @db.Decimal(12, 2)
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  appointments       Appointment[]
  appointmentDrafts  AppointmentDraft[]
  eventServices      EventService[]
  membershipServices MembershipService[]
  store              Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, name])
  @@index([storeId])
}

model UserProfile {
  userId         String   @id
  cpf            String?  @unique
  phone          String?
  secondaryPhone String?
  gender         String?
  birthDate      DateTime?
  zipcode        String?
  state          String?
  city           String?
  neighborhood   String?
  address        String?
  number         String?
  complement     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserContact {
  id           String   @id @default(cuid())
  userId       String
  name         String
  phone        String
  relationship String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Event {
  id          String         @id @default(cuid())
  storeId     String
  name        String
  description String?
  durationMin Int?
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  store       Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  services    EventService[]

  @@unique([storeId, name])
  @@index([storeId])
}

model EventService {
  eventId   String
  serviceId String
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([eventId, serviceId])
  @@index([serviceId])
}

model Conversation {
  id            String                @id @default(cuid())
  storeId       String
  channel       Channel
  contact       String
  state         ConversationState     @default(IDLE)
  context       Json?
  lastMessageAt DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  drafts        AppointmentDraft[]
  store         Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  messages      ConversationMessage[]

  @@unique([storeId, channel, contact])
  @@index([storeId, lastMessageAt])
}

model ConversationMessage {
  id                String           @id @default(cuid())
  storeId           String
  conversationId    String
  direction         MessageDirection
  providerMessageId String?
  text              String?
  payload           Json?
  createdAt         DateTime         @default(now())
  conversation      Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  store             Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, providerMessageId])
  @@index([conversationId, createdAt])
}

model AppointmentDraft {
  id                String       @id @default(cuid())
  storeId           String
  conversationId    String
  status            DraftStatus  @default(DRAFT)
  serviceId         String?
  staffMembershipId String?
  customerName      String?
  customerPhone     String?
  customerEmail     String?
  startAt           DateTime?
  endAt             DateTime?
  notes             String?
  channel           Channel
  appointmentId     String?      @unique
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  appointment       Appointment? @relation(fields: [appointmentId], references: [id])
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  service           Service?     @relation(fields: [serviceId], references: [id])
  membership        Membership?  @relation(fields: [staffMembershipId], references: [id])
  store             Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, status])
  @@index([conversationId, status])
}

model Appointment {
  id                String            @id @default(cuid())
  storeId           String
  status            AppointmentStatus @default(SCHEDULED)
  serviceId         String?
  staffMembershipId String?
  customerName      String
  customerPhone     String?
  customerEmail     String?
  startAt           DateTime
  endAt             DateTime
  notes             String?
  source            Channel
  externalRef       String?
  metadata          Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  service           Service?          @relation(fields: [serviceId], references: [id])
  membership        Membership?       @relation(fields: [staffMembershipId], references: [id])
  store             Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  draft             AppointmentDraft?

  @@index([storeId, startAt])
  @@index([storeId, status])
}

model WeekScheduleDay {
  id        String                 @id @default(cuid())
  storeId   String
  weekday   Weekday
  enabled   Boolean                @default(false)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  store     Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  intervals WeekScheduleInterval[]

  @@unique([storeId, weekday])
  @@index([storeId])
}

model WeekScheduleInterval {
  id        String          @id @default(cuid())
  dayId     String
  startTime String
  endTime   String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  day       WeekScheduleDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([dayId])
}

model MembershipWeekScheduleDay {
  id           String                          @id @default(cuid())
  membershipId String
  weekday      Weekday
  enabled      Boolean                         @default(false)
  createdAt    DateTime                        @default(now())
  updatedAt    DateTime                        @updatedAt
  membership   Membership                      @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  intervals    MembershipWeekScheduleInterval[]

  @@unique([membershipId, weekday])
  @@index([membershipId])
}

model MembershipWeekScheduleInterval {
  id        String                    @id @default(cuid())
  dayId     String
  startTime String
  endTime   String
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt
  day       MembershipWeekScheduleDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([dayId])
}

model BlockedSchedule {
  id           String      @id @default(cuid())
  storeId      String
  membershipId String?
  date         DateTime
  allDay       Boolean     @default(false)
  startTime    String?
  endTime      String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  membership   Membership? @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  store        Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, date])
  @@index([membershipId, date])
}

model WhatsAppConnection {
  id                 String                   @id
  storeId            String                   @unique
  provider           WhatsAppProvider         @default(META_WHATSAPP)
  phoneNumberId      String                   @unique
  businessAccountId  String
  displayPhoneNumber String
  verifyToken        String                   @unique
  accessToken        String
  status             WhatsAppConnectionStatus @default(PENDING)
  isActive           Boolean                  @default(true)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime
  Store              Store                    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([businessAccountId])
  @@index([provider, isActive])
}

enum GlobalRole {
  SUPER_ADMIN
}

enum MembershipRole {
  OWNER
  ADMIN
  STAFF
}

enum MembershipType {
  PROFISSIONAL
  FINANCEIRO
  ATENDENTE
}

enum Channel {
  WHATSAPP
  WEB
  ADMIN
}

enum WhatsAppConnectionStatus {
  PENDING
  VERIFIED
  CONNECTED
  DISCONNECTED
  ERROR
}

enum WhatsAppProvider {
  META_WHATSAPP
}

enum ConversationState {
  IDLE
  PAUSED
  COLLECTING_CUSTOMER
  CHOOSING_SERVICE
  CHOOSING_STAFF
  CHOOSING_TIME
  CONFIRMING
  CHOOSING_APPOINTMENT
  CHOOSING_APPOINTMENT_ACTION
  CONFIRMING_APPOINTMENT_CANCELLATION
}

enum MessageDirection {
  IN
  OUT
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CANCELED
  DONE
  NO_SHOW
}

enum DraftStatus {
  DRAFT
  CONFIRMED
  ABANDONED
}

enum Weekday {
  SUN
  MON
  TUE
  WED
  THU
  FRI
  SAT
}
